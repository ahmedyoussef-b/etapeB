# =============================================================================
# NexaFlow — Exemple de variables d'environnement (DÉVELOPPEMENT LOCAL)
# Copier → cp .env.local.example .env.local puis remplir les secrets.
# CE FICHIER NE CONTIENT AUCUN SECRET — il est commitable.
# En production, toutes les variables ci-dessous sont définies dans le
# dashboard Vercel (Settings > Environment Variables > Production).
# =============================================================================

# -----------------------------------------------------------------------------
# Base de données (Neon)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=verify-full
DIRECT_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=verify-full

# -----------------------------------------------------------------------------
# NextAuth
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=openssl rand -base64 32   # générer: `openssl rand -base64 32`
NEXTAUTH_URL=http://localhost:3000        # prod: https://etape-b.vercel.app

# -----------------------------------------------------------------------------
# Chat IA (Groq)
# ⚠️ GROQ_MODEL doit être un modèle ACCESSIBLE par la clé (voir docs/DEPLOYMENT.md)
#    Modèles testés-validés : openai/gpt-oss-120b (120B), groq/compound, openai/gpt-oss-20b
# -----------------------------------------------------------------------------
USE_GROQ=true
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=gsk_<your-groq-api-key>

# -----------------------------------------------------------------------------
# Cloudinary (upload d'images)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=ml_default
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# -----------------------------------------------------------------------------
# GitHub (pipeline / sync repo)
# -----------------------------------------------------------------------------
GITHUB_TOKEN=ghp_<your-token>
GITHUB_OWNER=ahmedyoussef-b
GITHUB_REPO=etapeB
GITHUB_BRANCH=main
NEXT_PUBLIC_GITHUB_OWNER=ahmedyoussef-b
NEXT_PUBLIC_GITHUB_REPO=etapeB
NEXT_PUBLIC_GITHUB_BRANCH=main

# -----------------------------------------------------------------------------
# Ably (WebSocket temps réel)
# -----------------------------------------------------------------------------
ABLY_API_KEY=
NEXT_PUBLIC_ABLY_API_KEY=

# -----------------------------------------------------------------------------
# Comptes seed admin (dev uniquement) — créés par `npm run db:seed`
# -----------------------------------------------------------------------------
OWNER_EMAIL=***************
OWNER_PASSWORD=**********

# -----------------------------------------------------------------------------
# Vector stores
# -----------------------------------------------------------------------------
WEAVIATE_URL=
WEAVIATE_API_KEY=
CHROMA_URL=http://127.0.0.1:8000
CHROMA_DB_PATH=./chroma-data

# -----------------------------------------------------------------------------
# Stockage / config app
# -----------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=
DATA_PROVIDER=neon
NEXT_PUBLIC_APP_MODE=dev

# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# -----------------------------------------------------------------------------
# Cloudflare
# -----------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=<your-cloudflare-account-id>
CLOUDFLARE_API_TOKEN=<your-cloudflare-api-token>

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=<your-redis-host>
REDIS_PORT=<your-redis-port>
REDIS_USER=<your-redis-user>
REDIS_PASSWORD=<your-redis-password>
REDIS_URL=redis://<user>:<password>@<host>:<port>

# -----------------------------------------------------------------------------
# Pusher
# -----------------------------------------------------------------------------
PUSHER_APP_ID=<your-pusher-app-id>
PUSHER_KEY=<your-pusher-key>
PUSHER_SECRET=<your-pusher-secret>
PUSHER_CLUSTER=<your-pusher-cluster>

# -----------------------------------------------------------------------------
# Vercel
# -----------------------------------------------------------------------------
VERCEL_OIDC_TOKEN=<your-vercel-oidc-token>
